    "<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #1e293b; max-width: 900px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-top: 15px; box-sizing: border-box;\">\n",
    "<!-- TWO-COLUMN STAKES & MECHANICS -->\n",
    "  <div style=\"display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 16px;\">\n",
    "    <!-- COLUMN 1: THE DIAGNOSTIC BREAKTHROUGH -->\n",
