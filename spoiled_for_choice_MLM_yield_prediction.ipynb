   "source": [
    "<div id=\"p2-snap\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color:#1a1a1a; max-width: 900px; line-height:1.5;\">\n",
    "  <h2 style=\"margin-bottom: 14px;\">Prediction Algorithm</h2>\n",
    "  <div>\n",
    "    <span style=\"display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; margin-right:6px; margin-bottom:6px; background:#eaf2ff; color:#1854c4;\">Prediction Tensor</span>\n",
    "    <span style=\"display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; margin-right:6px; margin-bottom:6px; background:#fef3c7; color:#92400e;\">Dispersion Weighting</span>\n",
    "    <span style=\"display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; margin-right:6px; margin-bottom:6px; background:#ecfdf5; color:#065f46;\">Point-Wise Error Reduction</span>\n",
    "  </div>\n",
    "</div>"
   ]
